# Copy to `.env` for local runs (never commit real secrets).
# Vercel project `gold-terminal-pro` already has these for production/preview.

# Neon Postgres (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# xAI (Quant / grok tools)
XAI_API_KEY=

# Client auth gate: "true" | "false"
# Spec/README often run with auth off locally; Vercel may set "true".
VITE_AUTH_ENABLED=false

# Set by Vercel deployer on publish — leave empty for local/workspace preview.
GROK_PROJECT_ID=

# better-auth base URL (use production domain on Vercel)
BETTER_AUTH_URL=http://localhost:8080
